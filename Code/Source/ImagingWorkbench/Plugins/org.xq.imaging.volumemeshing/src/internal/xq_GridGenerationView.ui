         </item>
         <item>
          <spacer name="localBtnSpacer">
           <property name="orientation"><enum>Qt::Horizontal</enum></property>
          </spacer>
         </item>
        </layout>
       </item>
      </layout>
     </widget>

     <!-- Boundary Layer Tab -->
     <widget class="QWidget" name="tabBoundaryLayer">
      <attribute name="title"><string>Boundary Layer</string></attribute>
      <layout class="QVBoxLayout" name="blLayout">
       <item>
        <widget class="QCheckBox" name="chkBoundaryLayer">
         <property name="text"><string>Enable Boundary Layer Mesh</string></property>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="grpBLParams">
         <property name="title"><string>Boundary Layer Parameters</string></property>
         <property name="enabled"><bool>false</bool></property>
         <layout class="QFormLayout" name="blFormLayout">
          <item row="0" column="0">
           <widget class="QLabel" name="lblBLLayers">
            <property name="text"><string>Number of Layers:</string></property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QSpinBox" name="spinBLLayers">
            <property name="minimum"><number>1</number></property>
            <property name="maximum"><number>20</number></property>
            <property name="value"><number>4</number></property>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="lblBLFirstHeight">
            <property name="text"><string>First Layer Height:</string></property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QDoubleSpinBox" name="spinBLFirstHeight">
            <property name="minimum"><double>0.001</double></property>
            <property name="maximum"><double>10.0</double></property>
            <property name="value"><double>0.1</double></property>
            <property name="singleStep"><double>0.01</double></property>
            <property name="decimals"><number>4</number></property>
           </widget>
          </item>
          <item row="2" column="0">
           <widget class="QLabel" name="lblBLGrowthRate">
            <property name="text"><string>Growth Rate:</string></property>
           </widget>
          </item>
          <item row="2" column="1">
           <widget class="QDoubleSpinBox" name="spinBLGrowthRate">
            <property name="minimum"><double>1.0</double></property>
            <property name="maximum"><double>5.0</double></property>
            <property name="value"><double>1.2</double></property>
            <property name="singleStep"><double>0.1</double></property>
            <property name="decimals"><number>2</number></property>
           </widget>
          </item>
          <item row="3" column="0" colspan="2">
           <widget class="QCheckBox" name="chkBLDirectionInward">
            <property name="text"><string>Direction Inward</string></property>
            <property name="checked"><bool>true</bool></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="btnPreviewBL">
         <property name="text"><string>Preview Boundary Layer</string></property>
         <property name="enabled"><bool>false</bool></property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="lblBLStatus">
         <property name="text"><string></string></property>
        </widget>
       </item>
       <item>
        <spacer name="blSpacer">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
        </spacer>
       </item>
      </layout>
