       <property name="enabled"><bool>false</bool></property>
      </widget>
     </item>
    </layout>
   </item>

   <!-- Tabs -->
   <item>
    <widget class="QTabWidget" name="tabMeshing">

     <!-- Global Settings Tab -->
     <widget class="QWidget" name="tabGlobal">
      <attribute name="title"><string>Global Settings</string></attribute>
      <layout class="QVBoxLayout" name="globalLayout">
       <item>
        <widget class="QGroupBox" name="grpGlobalParams">
         <property name="title"><string>Global Mesh Parameters</string></property>
         <layout class="QFormLayout" name="globalFormLayout">
          <item row="0" column="0">
           <widget class="QLabel" name="lblMeshType">
            <property name="text"><string>Mesh Type:</string></property>
           </widget>
          </item>
          <item row="0" column="1">
           <widget class="QComboBox" name="comboMeshType">
            <item><property name="text"><string>TetGen</string></property></item>
           </widget>
          </item>
          <item row="1" column="0">
           <widget class="QLabel" name="lblGlobalEdge">
            <property name="text"><string>Global Edge Size:</string></property>
           </widget>
          </item>
          <item row="1" column="1">
           <widget class="QDoubleSpinBox" name="spinGlobalEdgeSize">
            <property name="minimum"><double>0.001</double></property>
            <property name="maximum"><double>1000.0</double></property>
            <property name="value"><double>1.0</double></property>
            <property name="singleStep"><double>0.1</double></property>
            <property name="decimals"><number>3</number></property>
            <property name="enabled"><bool>false</bool></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="runLayout">
         <item>
          <widget class="QPushButton" name="btnRunMeshing">
           <property name="text"><string>Run Meshing</string></property>
           <property name="enabled"><bool>false</bool></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btnAdaptMesh">
           <property name="text"><string>Adapt Mesh</string></property>
           <property name="enabled"><bool>false</bool></property>
          </widget>
         </item>
        </layout>
       </item>
       <item>
        <spacer name="globalSpacer">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
        </spacer>
       </item>
      </layout>
     </widget>

     <!-- Local Size Tab -->
     <widget class="QWidget" name="tabLocal">
      <attribute name="title"><string>Local Size</string></attribute>
      <layout class="QVBoxLayout" name="localLayout">
       <item>
        <widget class="QTableWidget" name="tableLocalSize">
         <property name="minimumHeight"><number>150</number></property>
        </widget>
       </item>
       <item>
        <layout class="QHBoxLayout" name="localBtnLayout">
         <item>
          <widget class="QPushButton" name="btnAddLocalSize">
           <property name="text"><string>Add</string></property>
           <property name="enabled"><bool>false</bool></property>
          </widget>
         </item>
         <item>
          <widget class="QPushButton" name="btnRemoveLocalSize">
           <property name="text"><string>Remove</string></property>
