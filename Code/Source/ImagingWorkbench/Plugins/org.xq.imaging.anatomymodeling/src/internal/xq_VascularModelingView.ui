<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>xq_VascularModelingView</class>
 <widget class="QWidget" name="xq_VascularModelingView">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>400</width><height>700</height></rect>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <!-- Model selector -->
   <item>
    <layout class="QHBoxLayout" name="selectorLayout">
     <item>
      <widget class="QLabel" name="lblModel">
       <property name="text"><string>Model:</string></property>
      </widget>
     </item>
     <item>
      <widget class="QComboBox" name="comboModelSelector"/>
     </item>
    </layout>
   </item>

   <!-- Face table -->
   <item>
    <widget class="QTableWidget" name="tableFaces">
     <property name="minimumHeight"><number>150</number></property>
     <property name="selectionMode">
      <enum>QAbstractItemView::SingleSelection</enum>
     </property>
    </widget>
   </item>

   <!-- Operations tabs -->
   <item>
    <widget class="QTabWidget" name="tabOperations">
     <!-- Create tab -->
     <widget class="QWidget" name="tabCreate">
      <attribute name="title"><string>Create</string></attribute>
      <layout class="QVBoxLayout" name="createLayout">
       <item>
        <widget class="QPushButton" name="btnCreateModel">
         <property name="text"><string>Create Model...</string></property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="btnDeleteModel">
         <property name="text"><string>Delete Model</string></property>
         <property name="enabled"><bool>false</bool></property>
        </widget>
       </item>
       <item>
        <spacer name="createSpacer">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
        </spacer>
       </item>
      </layout>
     </widget>

     <!-- Edit tab -->
     <widget class="QWidget" name="tabEdit">
      <attribute name="title"><string>Edit</string></attribute>
      <layout class="QVBoxLayout" name="editLayout">
       <item>
        <widget class="QGroupBox" name="grpFaceOps">
         <property name="title"><string>Face Operations</string></property>
         <layout class="QVBoxLayout" name="faceOpsLayout">
          <item>
           <widget class="QPushButton" name="btnChangeFaceColor">
            <property name="text"><string>Change Face Color</string></property>
            <property name="enabled"><bool>false</bool></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btnToggleFaceVisibility">
            <property name="text"><string>Toggle Face Visibility</string></property>
            <property name="enabled"><bool>false</bool></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="grpBoolean">
         <property name="title"><string>Boolean Operations</string></property>
         <layout class="QVBoxLayout" name="boolLayout">
          <item>
           <widget class="QPushButton" name="btnBooleanUnion">
            <property name="text"><string>Union</string></property>
            <property name="enabled"><bool>false</bool></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btnBooleanSubtract">
            <property name="text"><string>Subtract</string></property>
            <property name="enabled"><bool>false</bool></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="grpBlending">
         <property name="title"><string>Face Blending (OCCT)</string></property>
         <layout class="QVBoxLayout" name="blendLayout">
          <item>
           <layout class="QHBoxLayout" name="blendTypeLayout">
            <item>
             <widget class="QLabel" name="lblBlendType">
              <property name="text"><string>Type:</string></property>
             </widget>
            </item>
            <item>
             <widget class="QComboBox" name="comboBlendType">
              <item><property name="text"><string>Fillet</string></property></item>
              <item><property name="text"><string>Chamfer</string></property></item>
             </widget>
            </item>
           </layout>
          </item>
          <item>
           <layout class="QHBoxLayout" name="filletRadLayout">
            <item>
             <widget class="QLabel" name="lblFilletRadius">
              <property name="text"><string>Radius:</string></property>
             </widget>
            </item>
            <item>
             <widget class="QDoubleSpinBox" name="spinFilletRadius">
              <property name="minimum"><double>0.010</double></property>
              <property name="maximum"><double>5.0</double></property>
              <property name="value"><double>0.1</double></property>
              <property name="singleStep"><double>0.01</double></property>
              <property name="decimals"><number>3</number></property>
             </widget>
            </item>
           </layout>
          </item>
          <item>
           <layout class="QHBoxLayout" name="filletIterLayout">
            <item>
             <widget class="QLabel" name="lblFilletIter">
              <property name="text"><string>Iterations:</string></property>
             </widget>
            </item>
            <item>
             <widget class="QSpinBox" name="spinFilletIterations">
              <property name="minimum"><number>1</number></property>
              <property name="maximum"><number>20</number></property>
              <property name="value"><number>3</number></property>
              <property name="toolTip"><string>Number of iterative smoothing passes applied to junction edges</string></property>
             </widget>
            </item>
           </layout>
          </item>
          <item>
           <widget class="QPushButton" name="btnApplyFillet">
            <property name="text"><string>Apply Blend</string></property>
            <property name="enabled"><bool>false</bool></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="grpDecimation">
         <property name="title"><string>Surface Decimation</string></property>
         <layout class="QVBoxLayout" name="decimationLayout">
          <item>
           <layout class="QHBoxLayout" name="decimationRatioLayout">
            <item>
             <widget class="QLabel" name="lblDecimationRatio">
              <property name="text"><string>Reduction Ratio:</string></property>
             </widget>
            </item>
            <item>
             <widget class="QDoubleSpinBox" name="spinDecimationRatio">
              <property name="minimum"><double>0.01</double></property>
              <property name="maximum"><double>0.99</double></property>
              <property name="value"><double>0.5</double></property>
              <property name="singleStep"><double>0.05</double></property>
             </widget>
            </item>
           </layout>
          </item>
          <item>
           <widget class="QCheckBox" name="chkPreserveTopology">
            <property name="text"><string>Preserve Topology</string></property>
            <property name="checked"><bool>true</bool></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btnDecimate">
            <property name="text"><string>Decimate Surface</string></property>
            <property name="enabled"><bool>false</bool></property>
           </widget>
          </item>
          <item>
           <widget class="QLabel" name="lblDecimationResult">
            <property name="text"><string></string></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <widget class="QGroupBox" name="grpSurfaceOps">
         <property name="title"><string>Surface Operations</string></property>
         <layout class="QVBoxLayout" name="surfaceOpsLayout">
          <item>
           <widget class="QPushButton" name="btnComputeNormals">
            <property name="text"><string>Compute Normals</string></property>
            <property name="enabled"><bool>false</bool></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btnCleanSurface">
            <property name="text"><string>Clean Surface</string></property>
            <property name="enabled"><bool>false</bool></property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="btnFillHoles">
            <property name="text"><string>Fill Holes</string></property>
            <property name="enabled"><bool>false</bool></property>
           </widget>
          </item>
          <item>
           <widget class="QLabel" name="lblSurfaceOpsResult">
            <property name="text"><string></string></property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>
       <item>
        <spacer name="editSpacer">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
        </spacer>
       </item>
      </layout>
     </widget>

     <!-- Export tab -->
     <widget class="QWidget" name="tabExport">
      <attribute name="title"><string>Export</string></attribute>
      <layout class="QVBoxLayout" name="exportLayout">
       <item>
        <widget class="QPushButton" name="btnExportModel">
         <property name="text"><string>Export Model (VTP/STL)...</string></property>
         <property name="enabled"><bool>false</bool></property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="btnModelStats">
         <property name="text"><string>Model Statistics</string></property>
         <property name="toolTip"><string>Show surface model statistics</string></property>
         <property name="enabled"><bool>false</bool></property>
        </widget>
       </item>
       <item>
        <widget class="QPushButton" name="btnExtractCenterlines">
         <property name="text"><string>Extract Centerline Paths</string></property>
         <property name="toolTip"><string>Create a centerline path seed from the selected model</string></property>
         <property name="enabled"><bool>false</bool></property>
        </widget>
       </item>
       <item>
        <spacer name="exportSpacer">
         <property name="orientation"><enum>Qt::Vertical</enum></property>
        </spacer>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
  </layout>
 </widget>
</ui>
