<?xml version="1.0" encoding="UTF-8"?>
<plugin>
  <extension point="org.blueberry.ui.views">
    <view id="org.xq.views.modeling"
          name="Geometric Construction"
          icon="resources/icon.png"
          class="xq_VascularModelingView"
          category="Stage 4 – Build"/>
  </extension>

  <extension point="org.blueberry.ui.preferencePages">
    <page id="org.xq.views.modeling.preferencepage"
          name="Geometric Construction"
          class="xq_ModelPreferencePage"/>
  </extension>

  <extension point="org.xq.core.datamanager.contextMenuActions">
    <contextMenuAction nodeDescriptorName="xq_ProfileGroup"
                       label="Create Model from Contours"
                       class="xq_ModelCreateAction"/>
  </extension>
</plugin>
