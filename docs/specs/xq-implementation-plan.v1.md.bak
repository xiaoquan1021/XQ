**xq_MitkApp 架构:**

继承 `mitk::BaseApplication`，重写 `initializeLibraryPaths()` 以添加 XQ 插件搜索路径。

```cpp
class XQ_QT_APPLICATION_EXPORT xqMitkApp : public mitk::BaseApplication
{
public:
    xqMitkApp(int argc, char *argv[]);
protected:
    void initializeLibraryPaths() override;
};
```

`initializeLibraryPaths()` 实现:
- 读取 `XQ_PLUGIN_PATH` 环境变量
- 添加可执行文件所在目录的 `plugins` 子目录
- 调用父类方法

**xq_Main 架构:**

```cpp
int xqMain(int argc, char *argv[])
{
    xqMitkApp app(argc, argv);
    app.setSingleMode(true);
    app.setApplicationName("XQApplication");
    app.setOrganizationName("XQ");
    app.setProperty(mitk::BaseApplication::PROP_PRODUCT, "org.xq.gui.qt.application.xqworkbench");

    // 预加载 MITK ext 库
    QStringList preloadLibs;
    preloadLibs << "liborg_mitk_gui_qt_ext";
    app.setPreloadLibraries(preloadLibs);

    // 定义启动插件列表
    QStringList pluginsToStart;
    // BlueBerry / MITK 基础插件
    pluginsToStart << "org_commontk_configadmin"
                   << "org_commontk_eventadmin"
                   << "org_blueberry_core_runtime"
                   << "org_blueberry_core_expressions"
                   << "org_blueberry_core_commands"
                   << "org_blueberry_ui_qt"
                   << "org_mitk_core_services"
                   << "org_mitk_gui_qt_application"
                   << "org_mitk_gui_qt_ext"
                   << "org_mitk_gui_qt_common";

    // XQ 自定义插件
    pluginsToStart << "org_xq_gui_qt_application"
                   << "org_xq_projectdatanodes"
                   << "org_xq_gui_qt_datamanager"
                   << "org_xq_gui_qt_projectmanager"
                   << "org_xq_gui_qt_pathplanning"
                   << "org_xq_gui_qt_segmentation"
                   << "org_xq_gui_qt_modeling"
                   << "org_xq_gui_qt_meshing"
                   << "org_xq_gui_qt_simulation"
                   << "org_xq_gui_qt_romsimulation"
                   << "org_xq_gui_qt_imageprocessing";

    app.setProperty(ctkPluginFrameworkLauncher::PROP_PLUGINS, pluginsToStart);
    return app.run();
}
```

