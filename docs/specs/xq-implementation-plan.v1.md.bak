### Task 1.3: Code 层 CMakeLists.txt

**Files:**
- Create: `~/XQ/Code/CMakeLists.txt`

**职责:** Code 层主 CMake，设置编译器选项，发现外部依赖，定义内部库名称变量，按顺序添加 Modules → Plugins → Application 子目录。

**关键内容:**

```cmake
cmake_minimum_required(VERSION 3.18.0)
project(XQ VERSION 1.0.0 LANGUAGES CXX C)

set(CMAKE_CXX_STANDARD 17)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)

# CMake module path
set(CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/CMake" ${CMAKE_MODULE_PATH})

# 引入 XQ 自定义 cmake 工具
include(XQMacros)
include(XQOptions)
include(XQExternals)

# 输出路径统一
set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/lib)
set(CMAKE_LIBRARY_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/lib)
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/bin)

# 内部库名称定义
set(XQ_LIB_MODULE_COMMON_NAME        "xqModuleCommon")
set(XQ_LIB_MODULE_PATH_NAME          "xqModulePath")
set(XQ_LIB_MODULE_SEGMENTATION_NAME  "xqModuleSegmentation")
set(XQ_LIB_MODULE_MODEL_NAME         "xqModuleModel")
set(XQ_LIB_MODULE_MESH_NAME          "xqModuleMesh")
set(XQ_LIB_MODULE_SIMULATION_NAME    "xqModuleSimulation")
set(XQ_LIB_MODULE_ROMSIM_NAME        "xqModuleROMSimulation")
set(XQ_LIB_MODULE_IMGPROC_NAME       "xqModuleImageProcessing")
set(XQ_LIB_MODULE_PROJECTMGMT_NAME   "xqModuleProjectManagement")
set(XQ_LIB_MODULE_QTWIDGETS_NAME     "xqModuleQtWidgets")

# Modules (按依赖顺序)
add_subdirectory(Source/xq4gui/Modules/Common)
add_subdirectory(Source/xq4gui/Modules/Path)
add_subdirectory(Source/xq4gui/Modules/Segmentation)
add_subdirectory(Source/xq4gui/Modules/Model/Common)
add_subdirectory(Source/xq4gui/Modules/Mesh/Common)
add_subdirectory(Source/xq4gui/Modules/Simulation)
add_subdirectory(Source/xq4gui/Modules/ROMSimulation)
add_subdirectory(Source/xq4gui/Modules/ImageProcessing)
add_subdirectory(Source/xq4gui/Modules/ProjectManagement)
add_subdirectory(Source/xq4gui/Modules/QtWidgets)

# Plugins (BlueBerry 插件)
if(XQ_USE_GUI)
  include(Source/xq4gui/Plugins/PluginList.cmake)
  foreach(_plugin ${XQ_PLUGINS})
    string(REPLACE ":" ";" _plugin_info ${_plugin})
    list(GET _plugin_info 0 _plugin_name)
    list(GET _plugin_info 1 _plugin_enabled)
    if(_plugin_enabled STREQUAL "ON")
      string(REPLACE "." "/" _plugin_dir ${_plugin_name})
      add_subdirectory(Source/xq4gui/Plugins/${_plugin_name})
    endif()
  endforeach()
endif()

# Application
add_subdirectory(Source/Application)
```

