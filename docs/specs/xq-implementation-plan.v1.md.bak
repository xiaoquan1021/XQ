### Task 1.2: 构建脚本

**Files:**
- Create: `~/XQ/build.sh`
- Create: `~/XQ/run-xq.sh`

**build.sh 内容:**

```bash
#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
SV_EXT="/home/xiaoquan/svExternals"

BUILD_DIR="$SCRIPT_DIR/xq-build"
mkdir -p "$BUILD_DIR"

export CXX=/usr/bin/g++
export CC=/usr/bin/gcc
export LD_LIBRARY_PATH="$SV_EXT/install/python-3.11.0/lib:$LD_LIBRARY_PATH"

cd "$BUILD_DIR"

cmake \
  -DCMAKE_BUILD_TYPE:STRING=Release \
  -DXQ_FREETYPE_DIR:PATH=$SV_EXT/install/freetype-2.13.0 \
  -DXQ_GDCM_DIR:PATH=$SV_EXT/install/gdcm-3.0.10/lib/gdcm-3.0 \
  -DXQ_HDF5_DIR:PATH=$SV_EXT/install/hdf5-1.14.3/cmake \
  -DXQ_ITK_DIR:PATH=$SV_EXT/install/itk-5.4.0/lib/cmake/ITK-5.4 \
  -DXQ_MITK_DIR:PATH=$SV_EXT/src/MITK-2024.06/build/MITK-build \
  -DXQ_MMG_DIR:PATH=$SV_EXT/install/mmg-5.3.9 \
  -DXQ_OpenCASCADE_DIR:PATH=$SV_EXT/install/opencascade-7.6.0/lib/cmake/opencascade \
  -DXQ_PYTHON_DIR:PATH=$SV_EXT/install/python-3.11.0 \
  -DXQ_Qt6_DIR:PATH=$SV_EXT/install/qt-6.7.0/lib/cmake/Qt6 \
  -DXQ_TINYXML2_DIR:PATH=$SV_EXT/install/tinyxml2-8.0.0/lib/cmake/tinyxml2 \
  -DXQ_VTK_DIR:PATH=$SV_EXT/install/vtk-9.3.0/lib/cmake/vtk-9.3 \
  -DPython3_EXECUTABLE:PATH=$SV_EXT/install/python-3.11.0/bin/python3 \
  "$SCRIPT_DIR"

make -j$(nproc)

echo "========================================="
echo "  XQ build finished successfully!"
echo "========================================="
```

**run-xq.sh 内容:**

```bash
#!/bin/bash
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BUILD_DIR="$SCRIPT_DIR/xq-build/XQ-build"
SV_EXT="/home/xiaoquan/svExternals"
MITK_DIR="$SV_EXT/src/MITK-2024.06/build/MITK-build"

export LD_LIBRARY_PATH="$BUILD_DIR/lib:$BUILD_DIR/lib/plugins:$MITK_DIR/lib:$MITK_DIR/lib/plugins"
export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$SV_EXT/install/vtk-9.3.0/lib"
export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$SV_EXT/install/itk-5.4.0/lib"
export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$SV_EXT/install/qt-6.7.0/lib"
export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$SV_EXT/install/mitk-2024.06/lib"
export LD_LIBRARY_PATH="$LD_LIBRARY_PATH:$SV_EXT/install/python-3.11.0/lib"
export QT_PLUGIN_PATH="$SV_EXT/install/qt-6.7.0/plugins"
export QT_QPA_PLATFORM=xcb

"$BUILD_DIR/bin/xq" "$@"
```

