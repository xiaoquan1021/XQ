**xq_ApplicationPluginActivator 架构:**

```cpp
class xqApplicationPluginActivator : public berry::AbstractUICTKPlugin
{
    Q_OBJECT
    Q_PLUGIN_METADATA(IID "org_xq_gui_qt_application")
    Q_INTERFACES(ctkPluginActivator)
public:
    void start(ctkPluginContext *context) override;
    void stop(ctkPluginContext *context) override;
    static ctkPluginContext *GetContext();
private:
    static ctkPluginContext *m_Context;
};
```

`start()` 实现:
```cpp
void xqApplicationPluginActivator::start(ctkPluginContext *context)
{
    berry::AbstractUICTKPlugin::start(context);
    m_Context = context;
    BERRY_REGISTER_EXTENSION_CLASS(xqDefaultPerspective, context)
    BERRY_REGISTER_EXTENSION_CLASS(xqApplication, context)
}
```

**plugin.xml:**

```xml
<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.2"?>
<plugin>
  <extension point="org.blueberry.osgi.applications">
    <application>
      <run class="xqApplication"/>
    </application>
  </extension>

  <extension point="org.blueberry.core.runtime.products">
    <product name="XQ" application="org.xq.qt.application"/>
  </extension>

  <extension point="org.blueberry.ui.perspectives">
    <perspective id="org.xq.application.defaultperspective"
                 name="XQ"
                 class="xqDefaultPerspective"
                 icon="resources/icon.png"/>
  </extension>
</plugin>
```

