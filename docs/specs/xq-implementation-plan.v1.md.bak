## Phase 1: CMake 构建系统与应用骨架

### Task 1.1: 顶层 CMakeLists.txt

**Files:**
- Create: `~/XQ/CMakeLists.txt`

**职责:** 使用 `ExternalProject_Add` 模式将 Code/ 目录作为子项目构建。定义所有外部依赖路径变量。

**关键内容:**

```cmake
cmake_minimum_required(VERSION 3.18.0)
project(XQ_TOP)

set(CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/Code/CMake" "${CMAKE_MODULE_PATH}")

include(ExternalProject)

# 外部依赖路径 (来自 ~/svExternals)
set(XQ_EXTERNALS_DIR "" CACHE STRING "XQ externals directory")
set(XQ_FREETYPE_DIR "" CACHE PATH "FreeType install directory")
set(XQ_GDCM_DIR "" CACHE PATH "GDCM install directory")
set(XQ_HDF5_DIR "" CACHE PATH "HDF5 install directory")
set(XQ_ITK_DIR "" CACHE PATH "ITK install directory")
set(XQ_MMG_DIR "" CACHE PATH "MMG install directory")
set(XQ_OpenCASCADE_DIR "" CACHE PATH "OpenCASCADE install directory")
set(XQ_PYTHON_DIR "" CACHE PATH "Python install directory")
set(XQ_Qt6_DIR "" CACHE PATH "Qt6 install directory")
set(XQ_TINYXML2_DIR "" CACHE PATH "TinyXML2 install directory")
set(XQ_VTK_DIR "" CACHE PATH "VTK install directory")
set(XQ_MITK_DIR "" CACHE PATH "MITK build directory")

# 构建选项
option(XQ_USE_GUI "Enable MITK/Qt GUI" ON)

ExternalProject_Add(XQ
  SOURCE_DIR ${CMAKE_CURRENT_SOURCE_DIR}/Code
  BINARY_DIR ${CMAKE_CURRENT_BINARY_DIR}/XQ-build
  DOWNLOAD_COMMAND ""
  UPDATE_COMMAND ""
  INSTALL_COMMAND ""
  CMAKE_CACHE_ARGS
    -DCMAKE_CXX_COMPILER:STRING=${CMAKE_CXX_COMPILER}
    -DCMAKE_C_COMPILER:STRING=${CMAKE_C_COMPILER}
    -DCMAKE_BUILD_TYPE:STRING=${CMAKE_BUILD_TYPE}
    -DBUILD_SHARED_LIBS:BOOL=ON
    -DXQ_FREETYPE_DIR:PATH=${XQ_FREETYPE_DIR}
    -DXQ_GDCM_DIR:PATH=${XQ_GDCM_DIR}
    -DXQ_HDF5_DIR:PATH=${XQ_HDF5_DIR}
    -DXQ_ITK_DIR:PATH=${XQ_ITK_DIR}
    -DXQ_MITK_DIR:PATH=${XQ_MITK_DIR}
    -DXQ_MMG_DIR:PATH=${XQ_MMG_DIR}
    -DXQ_OpenCASCADE_DIR:PATH=${XQ_OpenCASCADE_DIR}
    -DXQ_PYTHON_DIR:PATH=${XQ_PYTHON_DIR}
    -DXQ_Qt6_DIR:PATH=${XQ_Qt6_DIR}
    -DXQ_TINYXML2_DIR:PATH=${XQ_TINYXML2_DIR}
    -DXQ_VTK_DIR:PATH=${XQ_VTK_DIR}
    -DXQ_USE_GUI:BOOL=${XQ_USE_GUI}
)
```

