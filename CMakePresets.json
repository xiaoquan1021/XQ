{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release BlueBerry",
      "description": "Configure legacy XQ BlueBerry Workbench for Windows x64 with VS2022, Ninja, and isolated BlueBerry Externals output.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-msvc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/windows-msvc-release/install",
        "XQ_EXTERNALS_ROOT": "${sourceDir}/../Externals",
        "XQ_EXTERNALS_PLATFORM": "windows-x64-blueberry",
        "XQ_BUILD_TESTING": "ON",
        "XQ_BUILD_MONOLITH": "OFF",
        "XQ_BUILD_LEGACY_BLUEBERRY": "ON"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release BlueBerry",
      "description": "Configure legacy XQ BlueBerry Workbench for Linux x64 with the existing Externals layout.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/linux-release/install",
        "XQ_EXTERNALS_ROOT": "${sourceDir}/../Externals",
        "XQ_EXTERNALS_PLATFORM": "",
        "XQ_BUILD_TESTING": "ON",
        "XQ_BUILD_MONOLITH": "OFF",
        "XQ_BUILD_LEGACY_BLUEBERRY": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
