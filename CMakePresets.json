{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-release",
      "displayName": "Windows MSVC Release",
      "description": "Configure XQ for Windows x64 with VS2022, Ninja, and platformed Externals output.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-msvc-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/windows-msvc-release/install",
        "XQ_EXTERNALS_ROOT": "${sourceDir}/../Externals",
        "XQ_EXTERNALS_PLATFORM": "windows-x64",
        "XQ_BUILD_TESTING": "ON",
        "XQ_BUILD_MONOLITH": "ON",
        "XQ_BUILD_LEGACY_BLUEBERRY": "OFF"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux Release",
      "description": "Configure XQ with the existing Linux Externals layout.",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/build/linux-release/install",
        "XQ_BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-release",
      "configurePreset": "windows-msvc-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
