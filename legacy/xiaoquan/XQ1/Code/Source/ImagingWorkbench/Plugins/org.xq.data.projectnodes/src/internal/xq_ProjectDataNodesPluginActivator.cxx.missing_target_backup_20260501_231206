        tr("xq_ProfileGroup"),
        QIcon(QStringLiteral(":xq_contour.png")),
        mitk::NodePredicateDataType::New("xq_ProfileGroup"),
        descriptorManager));

    // Model data type
    descriptorManager->AddDescriptor(new QmitkNodeDescriptor(
        tr("xq_Model"),
        QIcon(QStringLiteral(":xq_model.png")),
        mitk::NodePredicateDataType::New("xq_Model"),
        descriptorManager));

    // Mesh data type
    descriptorManager->AddDescriptor(new QmitkNodeDescriptor(
        tr("xq_MitkGrid"),
        QIcon(QStringLiteral(":xq_mesh.png")),
        mitk::NodePredicateDataType::New("xq_MitkGrid"),
        descriptorManager));

    // Simulation job data type
    descriptorManager->AddDescriptor(new QmitkNodeDescriptor(
        tr("xq_MitkSolverJob"),
        QIcon(QStringLiteral(":xq_simulation.png")),
        mitk::NodePredicateDataType::New("xq_MitkSolverJob"),
        descriptorManager));

    // ROM simulation job data type
    descriptorManager->AddDescriptor(new QmitkNodeDescriptor(
        tr("xq_MitkROMSimJob"),
        QIcon(QStringLiteral(":xq_rom_simulation.png")),
        mitk::NodePredicateDataType::New("xq_MitkROMSimJob"),
        descriptorManager));

    // Multi-physics job data type
    descriptorManager->AddDescriptor(new QmitkNodeDescriptor(
        tr("xq_MitkMPJob"),
        QIcon(QStringLiteral(":xq_multiphysics.png")),
        mitk::NodePredicateDataType::New("xq_MitkMPJob"),
        descriptorManager));

    // Folder data types (all use xq_project.png icon)
    descriptorManager->AddDescriptor(new QmitkNodeDescriptor(
        tr("xq_ImageFolder"),
        QIcon(QStringLiteral(":xq_project.png")),
        mitk::NodePredicateDataType::New("xq_ImageFolder"),
        descriptorManager));

    descriptorManager->AddDescriptor(new QmitkNodeDescriptor(
        tr("xq_PathFolder"),
        QIcon(QStringLiteral(":xq_project.png")),
        mitk::NodePredicateDataType::New("xq_PathFolder"),
        descriptorManager));

    descriptorManager->AddDescriptor(new QmitkNodeDescriptor(
        tr("xq_SegmentationFolder"),
        QIcon(QStringLiteral(":xq_project.png")),
        mitk::NodePredicateDataType::New("xq_SegmentationFolder"),
        descriptorManager));

    descriptorManager->AddDescriptor(new QmitkNodeDescriptor(
        tr("xq_ModelFolder"),
        QIcon(QStringLiteral(":xq_project.png")),
        mitk::NodePredicateDataType::New("xq_ModelFolder"),
        descriptorManager));

    descriptorManager->AddDescriptor(new QmitkNodeDescriptor(
        tr("xq_GridFolder"),
        QIcon(QStringLiteral(":xq_project.png")),
        mitk::NodePredicateDataType::New("xq_GridFolder"),
        descriptorManager));

    descriptorManager->AddDescriptor(new QmitkNodeDescriptor(
        tr("xq_SimulationFolder"),
        QIcon(QStringLiteral(":xq_project.png")),
        mitk::NodePredicateDataType::New("xq_SimulationFolder"),
        descriptorManager));

    descriptorManager->AddDescriptor(new QmitkNodeDescriptor(
        tr("xq_ROMSimulationFolder"),
        QIcon(QStringLiteral(":xq_project.png")),
        mitk::NodePredicateDataType::New("xq_ROMSimulationFolder"),
        descriptorManager));

    descriptorManager->AddDescriptor(new QmitkNodeDescriptor(
        tr("xq_MultiPhysicsFolder"),
        QIcon(QStringLiteral(":xq_project.png")),
        mitk::NodePredicateDataType::New("xq_MultiPhysicsFolder"),
        descriptorManager));

    descriptorManager->AddDescriptor(new QmitkNodeDescriptor(
        tr("xq_RepositoryFolder"),
        QIcon(QStringLiteral(":xq_project.png")),
        mitk::NodePredicateDataType::New("xq_RepositoryFolder"),
        descriptorManager));

    descriptorManager->AddDescriptor(new QmitkNodeDescriptor(
        tr("xq_ProjectFolder"),
        QIcon(QStringLiteral(":xq_project.png")),
        mitk::NodePredicateDataType::New("xq_ProjectFolder"),
        descriptorManager));
}

void xq_ProjectDataNodesPluginActivator::stop(ctkPluginContext* context)
{
