}

void xq_ProjectDataNodesPluginActivator::LoadModules()
{
    // XQ fix: the previous library names (e.g. "lib_xq_Modeling") never
    // matched the real CMake output ("libxqModuleModelCommon.so"), so
    // QLibrary::load() silently failed and the static mapper-factory
    // registrations inside those libs never ran. That is the root cause
    // of Paths / Segmentations / Models / Meshes / Simulations showing
    // up in the tree but producing no renderable geometry.
    //
    // Use the actual library base names (without the "lib" prefix and
    // without ".so") so Qt resolves them correctly. These calls have
    // the side effect of forcing the static initializers (and therefore
    // the mapper factory registrations) to execute before any data node
    // reaches the rendering pipeline.
    LoadLibrary("xq_Path (centerlines)",      "xqModulePath");
    LoadLibrary("xq_Segmentation",             "xqModuleSegmentation");
    LoadLibrary("xq_ModelCommon",              "xqModuleModelCommon");
    LoadLibrary("xq_ModelOCCT",                "xqModuleModelOCCT");
    LoadLibrary("xq_MeshCommon",               "xqModuleMeshCommon");
    LoadLibrary("xq_Simulation",               "xqModuleSimulation");
    LoadLibrary("xq_ROMSimulation",            "xqModuleROMSimulation");
    LoadLibrary("xq_MultiPhysics",             "xqModuleMultiPhysics");
}

void xq_ProjectDataNodesPluginActivator::LoadLibrary(QString name, QString libFileName)
{
    QLibrary lib(libFileName);
    if (!lib.load())
    {
        MITK_WARN << "[xq.data.projectnodes] Unable to load "
                  << name.toStdString() << " from " << libFileName.toStdString()
                  << ": " << lib.errorString().toStdString();
    }
}
