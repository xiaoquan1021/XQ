/* iconColor       : #475569 */
/* iconAccentColor : #2563EB */

/* ==========================================================
   XQ Application Stylesheet
   Arctic Light + Royal Blue theme
   ========================================================== */

/* Main Window */
QMainWindow {
    background: #F8FAFC;
}

/* Menu Bar */
QMenuBar {
    background: #F1F5F9;
    border-bottom: 1px solid #E2E8F0;
    padding: 1px 0;
    color: #1E293B;
}
QMenuBar::item {
    padding: 5px 12px;
    border-radius: 4px;
    color: #1E293B;
}
QMenuBar::item:selected {
    background: #2563EB;
    color: #FFFFFF;
}

/* Menus */
QMenu {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    padding: 4px 0;
    color: #1E293B;
}
QMenu::item {
    padding: 6px 30px 6px 24px;
}
QMenu::item:selected {
    background: #2563EB;
    color: #FFFFFF;
}
QMenu::item:disabled {
    color: #94A3B8;
}
QMenu::separator {
    height: 1px;
    background: #E2E8F0;
    margin: 4px 10px;
}
QMenu::icon {
    padding-left: 6px;
}

/* Toolbar */
QToolBar {
    background: #F1F5F9;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    spacing: 3px;
    padding: 3px 6px;
}
QToolBar::separator {
    width: 1px;
    background: #E2E8F0;
    margin: 3px 4px;
}
QToolBar QToolButton {
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 3px 8px;
    color: #1E293B;
    background: transparent;
}
QToolBar QToolButton:hover {
    background: #EFF6FF;
    border: 1px solid #2563EB;
}
QToolBar QToolButton:pressed {
    background: #DBEAFE;
    border: 1px solid #93C5FD;
    color: #1E293B;
}
QToolBar QToolButton:checked {
    background: #DBEAFE;
    border: 1px solid #93C5FD;
    color: #1E293B;
}

/* Dock Widget (View Panels) */
QDockWidget {
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
    color: #1E293B;
    font-weight: bold;
}
QDockWidget::title {
    background: #EFF6FF;
    border: none;
    border-left: 4px solid #2563EB;
    border-bottom: 1px solid #DBEAFE;
    padding: 8px 12px 8px 10px;
    font-weight: 600;
    font-size: 13px;
    text-align: left;
    color: #1E40AF;
}
QDockWidget::close-button, QDockWidget::float-button {
    border: none;
    padding: 2px;
    border-radius: 3px;
    icon-size: 12px;
}
QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background: #DBEAFE;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #E2E8F0;
    background: #FFFFFF;
}
QTabBar::tab {
    background: #FFFFFF;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 6px 16px;
    color: #64748B;
    margin-right: 1px;
}
QTabBar::tab:selected {
    background: #FFFFFF;
    border-bottom: 2px solid #2563EB;
    color: #1E293B;
}
QTabBar::tab:hover:!selected {
    background: #EFF6FF;
    color: #1E293B;
}

/* Splitter */
QSplitter::handle {
    background: #E2E8F0;
}
QSplitter::handle:horizontal {
    width: 3px;
}
QSplitter::handle:vertical {
    height: 3px;
}
QSplitter::handle:hover {
    background: #2563EB;
}

/* Tree View */
QTreeView {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    alternate-background-color: #F8FAFC;
    color: #1E293B;
}
QTreeView::item {
    padding: 2px 0;
}
QTreeView::item:selected {
    background: #2563EB;
    color: #FFFFFF;
}
QTreeView::item:hover:!selected {
    background: #EFF6FF;
}
QTreeView::branch:has-children:!has-siblings:closed,
QTreeView::branch:closed:has-children:has-siblings {
    border-image: none;
}

/* List View / List Widget */
QListView, QListWidget {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    alternate-background-color: #F8FAFC;
    color: #1E293B;
}
QListView::item:selected, QListWidget::item:selected {
    background: #2563EB;
    color: #FFFFFF;
}
QListView::item:hover, QListWidget::item:hover {
    background: #EFF6FF;
}

/* Group Box */
QGroupBox {
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 18px;
    font-weight: bold;
    color: #1E293B;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #2563EB;
}
QGroupBox:disabled {
    border-color: #E2E8F0;
}
QGroupBox:disabled::title {
    color: #94A3B8;
}

/* Push Button */
QPushButton {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    padding: 5px 18px;
    min-height: 20px;
    color: #1E293B;
}
QPushButton:hover {
    background: #EFF6FF;
    border-color: #2563EB;
    color: #2563EB;
}
QPushButton:pressed {
    background: #DBEAFE;
    color: #1E293B;
    border-color: #93C5FD;
}
QPushButton:disabled {
    background: #F1F5F9;
    color: #94A3B8;
    border-color: #E2E8F0;
}
QPushButton:checked {
    background: #2563EB;
    color: #FFFFFF;
    border-color: #1D4ED8;
}

/* Line Edit */
QLineEdit {
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    padding: 4px 6px;
    background: #FFFFFF;
    color: #1E293B;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}
QLineEdit:focus {
    border-color: #2563EB;
}
QLineEdit:disabled {
    background: #F1F5F9;
    color: #94A3B8;
}

/* Text Edit / Plain Text Edit */
QTextEdit, QPlainTextEdit {
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    background: #FFFFFF;
    color: #1E293B;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}
QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #2563EB;
}

/* Combo Box */
QComboBox {
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    padding: 4px 8px;
    background: #FFFFFF;
    color: #1E293B;
    min-height: 20px;
}
QComboBox:hover {
    border-color: #2563EB;
}
QComboBox:focus {
    border-color: #2563EB;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border-left: 1px solid #CBD5E1;
}
QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}

/* Spin Box */
QSpinBox, QDoubleSpinBox {
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    padding: 3px 6px;
    background: #FFFFFF;
    color: #1E293B;
    min-height: 20px;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
}
QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: #2563EB;
}

/* Up/down spinner buttons — make them visible and clickable on every
 * QSpinBox / QDoubleSpinBox (including the 7 boxes in Image Navigator).
 * Qt only renders the arrow sub-controls when we also style them
 * explicitly (otherwise overriding ::up-button alone silently hides
 * the arrows).
 */
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 14px;
    border-left: 1px solid #CBD5E1;
    border-top-right-radius: 4px;
    background: #F1F5F9;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 14px;
    border-left: 1px solid #CBD5E1;
    border-top: 1px solid #CBD5E1;
    border-bottom-right-radius: 4px;
    background: #F1F5F9;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: #E2E8F0;
}
QSpinBox::up-button:pressed, QDoubleSpinBox::up-button:pressed,
QSpinBox::down-button:pressed, QDoubleSpinBox::down-button:pressed {
    background: #CBD5E1;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(:/xq/arrow-up.svg);
    width: 8px;
    height: 5px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(:/xq/arrow-down.svg);
    width: 8px;
    height: 5px;
}
QSpinBox::up-arrow:disabled, QDoubleSpinBox::up-arrow:disabled,
QSpinBox::up-arrow:off,      QDoubleSpinBox::up-arrow:off {
    image: url(:/xq/arrow-up-disabled.svg);
}
QSpinBox::down-arrow:disabled, QDoubleSpinBox::down-arrow:disabled,
QSpinBox::down-arrow:off,      QDoubleSpinBox::down-arrow:off {
    image: url(:/xq/arrow-down-disabled.svg);
}

/* Check Box */
QCheckBox {
    spacing: 6px;
    color: #1E293B;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    background: #FFFFFF;
}
QCheckBox::indicator:checked {
    background: #2563EB;
    border-color: #1D4ED8;
}
QCheckBox::indicator:hover {
    border-color: #2563EB;
}
QCheckBox:disabled {
    color: #94A3B8;
}

/* Radio Button */
QRadioButton {
    spacing: 6px;
    color: #1E293B;
}
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    background: #FFFFFF;
}
QRadioButton::indicator:checked {
    background: #2563EB;
    border-color: #1D4ED8;
}
QRadioButton::indicator:hover {
    border-color: #2563EB;
}
QRadioButton:disabled {
    color: #94A3B8;
}

/* Scroll Bar - Vertical */
QScrollBar:vertical {
    background: #F1F5F9;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 4px;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
}

/* Scroll Bar - Horizontal */
QScrollBar:horizontal {
    background: #F1F5F9;
    height: 8px;
    margin: 0;
}
QScrollBar::handle:horizontal {
    background: #CBD5E1;
    border-radius: 4px;
    min-width: 24px;
}
QScrollBar::handle:horizontal:hover {
    background: #94A3B8;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    background: none;
}

/* Status Bar */
QStatusBar {
    background: #E8EDF4;
    border-top: 1px solid #E2E8F0;
    padding: 2px;
    color: #64748B;
}
QStatusBar::item {
    border: none;
}

/* Table View / Table Widget */
QTableView, QTableWidget {
    background: #FFFFFF;
    gridline-color: #E2E8F0;
    border: 1px solid #CBD5E1;
    selection-background-color: #2563EB;
    selection-color: #FFFFFF;
    alternate-background-color: #F8FAFC;
    color: #1E293B;
}
QTableView::item, QTableWidget::item {
    padding: 3px 6px;
}

/* Header View */
QHeaderView::section {
    background: #F8FAFC;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    border-right: 1px solid #E2E8F0;
    padding: 4px 8px;
    font-weight: bold;
    color: #64748B;
}
QHeaderView::section:hover {
    background: #EFF6FF;
    color: #1E293B;
}

/* Progress Bar */
QProgressBar {
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    text-align: center;
    background: #FFFFFF;
    min-height: 16px;
    color: #1E293B;
    font-size: 11px;
}
QProgressBar::chunk {
    background: #2563EB;
    border-radius: 3px;
}

/* Slider */
QSlider::groove:horizontal {
    height: 6px;
    background: #CBD5E1;
    border-radius: 3px;
}
QSlider::handle:horizontal {
    background: #2563EB;
    width: 14px;
    margin: -4px 0;
    border-radius: 7px;
}
QSlider::handle:horizontal:hover {
    background: #1D4ED8;
}
QSlider::groove:vertical {
    width: 6px;
    background: #CBD5E1;
    border-radius: 3px;
}
QSlider::handle:vertical {
    background: #2563EB;
    height: 14px;
    margin: 0 -4px;
    border-radius: 7px;
}
QSlider::handle:vertical:hover {
    background: #1D4ED8;
}

/* Image Navigator — cap slider-row width so the composite widget
 * (slider + value spinbox) never overflows the narrow left-column dock.
 * Without this MITK's QmitkSliceNavigationWidget expands to fill any
 * horizontal space and triggers a horizontal scrollbar on the dock.
 */
QmitkSliceNavigationWidget {
    max-width: 200px;
}
QmitkSliceNavigationWidget QSlider {
    max-width: 150px;
}

/* Image Navigator — shrink the three world-coordinate spinboxes on the
 * "Loc. (mm)" row so the row fits inside the dock without a scrollbar.
 * Sizes are tight but still wide enough for typical mm values like
 * "-999.99". Narrow further only if you're sure your datasets never
 * exceed 4 integer digits in world coordinates.
 */
QDoubleSpinBox#m_XWorldCoordinateSpinBox,
QDoubleSpinBox#m_YWorldCoordinateSpinBox,
QDoubleSpinBox#m_ZWorldCoordinateSpinBox {
    min-width: 58px;
    max-width: 66px;
}

/* Tooltip */
QToolTip {
    background: #FFFFFF;
    border: 1px solid #CBD5E1;
    color: #1E293B;
    padding: 4px 8px;
    border-radius: 4px;
}

/* Dialog */
QDialog {
    background: #F8FAFC;
}

QDialogButtonBox QPushButton {
    min-width: 80px;
    min-height: 28px;
}

/* ========== Main Actions Toolbar ========== */
QToolBar#mainActionsToolBar {
    background: #F1F5F9;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    spacing: 2px;
    padding: 2px 8px;
}

QToolBar#mainActionsToolBar QToolButton {
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 3px 10px;
    min-width: 28px;
    min-height: 24px;
    icon-size: 24px;
    font-size: 12px;
    color: #1E293B;
    background: transparent;
}

QToolBar#mainActionsToolBar QToolButton:hover {
    background: #EFF6FF;
    border: 1px solid #2563EB;
}

QToolBar#mainActionsToolBar QToolButton:pressed {
    background: #DBEAFE;
    border: 1px solid #93C5FD;
    color: #1E293B;
}

QToolBar#mainActionsToolBar QToolButton:checked {
    background: #DBEAFE;
    border: 1px solid #93C5FD;
    color: #1E293B;
}

/* ========== Perspective Toolbar ========== */
QToolBar#perspectiveToolBar {
    background: #F1F5F9;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    spacing: 2px;
    padding: 2px 8px;
}

QToolBar#perspectiveToolBar QToolButton {
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 3px 10px;
    font-size: 12px;
    color: #1E293B;
    background: transparent;
}

QToolBar#perspectiveToolBar QToolButton:hover {
    background: #EFF6FF;
    border: 1px solid #2563EB;
}

QToolBar#perspectiveToolBar QToolButton:pressed {
    background: #DBEAFE;
    border: 1px solid #93C5FD;
    color: #1E293B;
}

QToolBar#perspectiveToolBar QToolButton:checked {
    background: #EFF6FF;
    border: 1px solid #93C5FD;
    border-left: 3px solid #2563EB;
}

/* ========== XQ Views Toolbar ========== */
QToolBar#xqViewToolBar {
    background: #F1F5F9;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    spacing: 1px;
    padding: 2px 8px;
}

QToolBar#xqViewToolBar QToolButton {
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 3px 8px;
    font-size: 11px;
    font-weight: 500;
    color: #1E293B;
    background: transparent;
}

QToolBar#xqViewToolBar QToolButton:hover {
    background: #EFF6FF;
    border: 1px solid #2563EB;
    color: #2563EB;
}

QToolBar#xqViewToolBar QToolButton:pressed {
    background: #DBEAFE;
    border: 1px solid #93C5FD;
    color: #1E293B;
}

QToolBar#xqViewToolBar QToolButton:checked {
    background: #EFF6FF;
    border: 1px solid #93C5FD;
    border-left: 3px solid #2563EB;
}

/* ========== Views Toolbar ========== */
QToolBar#viewToolBar {
    background: #F1F5F9;
    border: none;
    border-bottom: 1px solid #E2E8F0;
    spacing: 2px;
    padding: 2px 8px;
}

QToolBar#viewToolBar QToolButton {
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 3px 8px;
    font-size: 11px;
    color: #1E293B;
    background: transparent;
}

QToolBar#viewToolBar QToolButton:hover {
    background: #EFF6FF;
    border: 1px solid #2563EB;
}

QToolBar#viewToolBar QToolButton:pressed {
    background: #DBEAFE;
    border: 1px solid #93C5FD;
    color: #1E293B;
}

QToolBar#viewToolBar QToolButton:checked {
    background: #EFF6FF;
    border: 1px solid #93C5FD;
    border-left: 3px solid #2563EB;
}

/* ========== MITK Render Window Controls ========== */
QmitkRenderWindow {
    background: #F8FAFC;
    border: 1px solid #E2E8F0;
}

/* ========== CTK Plugin Framework Widgets ========== */
ctkCollapsibleGroupBox {
    border: 1px solid #CBD5E1;
    border-radius: 4px;
    margin-top: 10px;
    padding-top: 18px;
    font-weight: bold;
    color: #1E293B;
}
ctkCollapsibleGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #2563EB;
}

/* ========== QFrame separators ========== */
QFrame[frameShape="4"], QFrame[frameShape="5"] {
    color: #E2E8F0;
}

/* ========== Widget/Label defaults ========== */
QWidget {
    font-family: "Segoe UI", "Noto Sans", "Helvetica Neue", sans-serif;
}
QLabel {
    color: #1E293B;
}
QLabel:disabled {
    color: #94A3B8;
}

/* Ensure icon-only toolbar buttons have proper sizing */
QToolBar QToolButton {
    min-width: 24px;
    min-height: 24px;
    icon-size: 18px;
}

QToolBar#mainActionsToolBar QToolButton {
    min-width: 28px;
    min-height: 24px;
    icon-size: 24px;
}

/* ========== BlueBerry View Tabs (XQ Data Manager, etc.) ========== */
berry--QCTabBar::tab {
    background: #F1F5F9;
    min-height: 26px;
    border: 1px solid #CBD5E1;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    padding: 4px 12px;
    margin-right: 2px;
    color: #475569;
    font-size: 12px;
}
berry--QCTabBar::tab:only-one {
    background: #EFF6FF;
    border: 1px solid #BFDBFE;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    min-height: 28px;
    color: #1E40AF;
    font-weight: 600;
}
berry--QCTabBar::tab:selected {
    background: #EFF6FF;
    border: 1px solid #93C5FD;
    border-bottom: 2px solid #2563EB;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    color: #1E40AF;
    font-weight: 600;
}
berry--QCTabBar::tab:hover:!selected {
    background: #E0E7FF;
    color: #1E293B;
}
berry--QCTabBar::tab:first {
    margin-left: 0px;
}
berry--QCTabBar::tab:last {
    margin-right: 0px;
}
berry--QCTabBar QToolButton {
    border: none;
    background: transparent;
    max-height: 22px;
}
berry--QCTabBar QToolButton#TabCloseButton {
    border: none;
    background: none;
}
berry--QCTabBar QToolButton#TabCloseButton:hover {
    background: #FEE2E2;
    border-radius: 3px;
}

/* BlueBerry View Content Frame */
QFrame#ViewFormContentFrame {
    border: 1px solid #DBEAFE;
    background: #FFFFFF;
}
QWidget#StandaloneViewForm {
    border: 1px solid #CBD5E1;
    background: #FFFFFF;
}
QWidget#TabTopRightControls {
    border: 1px solid #CBD5E1;
    border-left: none;
    border-top: none;
    border-right: none;
    background: #F1F5F9;
}
QWidget#PageCompositeControlWidget {
    margin: 3px;
}
